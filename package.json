{
  "name": "cloudwave",
  "productName": "Cloudwave",
  "version": "0.1.0",
  "description": "Cloudwave — a calm, native-feeling desktop shell for SoundCloud",
  "author": "Cloudwave contributors",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "screenshots": "electron scripts/capture.cjs",
    "verify:live": "electron scripts/verify-live.cjs",
    "dist": "electron-vite build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "app.cloudwave.desktop",
    "productName": "Cloudwave",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Cloudwave"
    }
  }
}
